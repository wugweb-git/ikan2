      "days": [
        {
          "day": 9,
          "title": "Perfecting Imperfection",
          "kind": "learning",
          "declaredBlocks": 6,
          "subtitle": "Action beats perfection.",
          "blocks": [
            {
              "n": 1,
              "title": "Imperfection",
              "type": "lesson",
              "minutes": 2,
              "body": [
                {
                  "kind": "p",
                  "text": "Perfectionism delays progress. Waiting for the right moment, rewriting the first line, or polishing something nobody asked for are all ways of not finishing."
                },
                {
                  "kind": "p",
                  "text": "Good enough means it does the job it's for. A sent email that's 90% right beats a perfect one still in drafts."
                }
              ],
              "notes": []
            },
