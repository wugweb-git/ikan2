# Copy to .env for local development. Nothing in this app currently reads these: the Supabase
# client the app actually uses is src/lib/backend.ts, which hard-codes the iKAN project's url
# and publishable key on purpose, so the Android shell works with no build-time configuration.
#
# These exist because Lovable's Supabase integration generated src/integrations/supabase/,
# which is not imported anywhere. If that client is ever adopted, fill these in.

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Overrides the Google Analytics measurement id. Unset means the one in src/lib/analytics.ts.
VITE_GA_ID=
